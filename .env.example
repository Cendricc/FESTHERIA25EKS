# Salin file ini menjadi ".env" lalu isi sesuai kebutuhanmu

PORT=3000

# ==== KONFIGURASI EVENT ====
EVENT_NAME=Nama Event Kamu
# EVENT_TICKET_PRICE cuma dipakai SEKALI sebagai nilai awal saat instalasi pertama kali.
# Setelah itu, harga tiket per batch (1/2/3/OTS) diatur lewat dashboard admin
# (tab "Kontrol Pendaftaran"), TIDAK dari sini lagi.
EVENT_TICKET_PRICE=50000

# ==== KONFIGURASI PANITIA (untuk login dashboard admin) ====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ubah-password-ini

# ==== KONFIGURASI PEMBAYARAN MANUAL (Transfer Bank) ====
# Ini yang akan ditampilkan ke pembeli di halaman pembayaran.
# Untuk gambar QRIS, ganti langsung file public/images/qris.jpg dengan QRIS asli kamu.
BANK_NAME=BCA
BANK_ACCOUNT_NUMBER=1234567890
BANK_ACCOUNT_HOLDER=Nama Kamu

# ==== KONFIGURASI PENYIMPANAN DATA (khusus deploy ke server produksi) ====
# Biarkan KOSONG saat development di laptop - otomatis pakai folder lokal.
# Saat deploy ke Railway/Render/VPS dengan persistent volume, isi dengan path
# folder yang di-mount sebagai volume tersebut, contoh: /app/storage
# Database (tickets.db) dan bukti pembayaran akan otomatis disimpan di dalamnya.
STORAGE_DIR=
